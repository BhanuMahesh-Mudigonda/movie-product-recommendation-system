FROM python:3.12-slim

WORKDIR /app

# Copy requirements and install
COPY product-recommendation/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy product recommendation app files
COPY product-recommendation/ product-recommendation/

ENV PYTHONUNBUFFERED=1
ENV PORT=8001

EXPOSE 8001

CMD ["sh", "-c", "uvicorn app:app --app-dir product-recommendation --host 0.0.0.0 --port ${PORT:-8001}"]
